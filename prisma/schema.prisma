// Kitchen-Up Inventory Management System
// Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum AdjustmentType {
  PREP
  WASTE
  MANUAL
}

enum AlertStatus {
  ACTIVE
  RESOLVED
  DISMISSED
}

enum Language {
  EN
  ES
}

/// Where a physical count was taken. Par levels key off the cooler, while an
/// ordering walk covers dry storage and the walk-in too, so the area a count
/// covered has to travel with the number.
enum StorageArea {
  COOLER
  LINE
  DRY
  WALKIN
}

/// Which routine produced the count: the weekly ordering walk, or the morning
/// cooler count that drives the prep list.
enum CountType {
  ORDER
  PREP
}

// ============================================================================
// MODELS
// ============================================================================

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String
  pin        String
  role       Role     @default(STAFF)
  locationId String
  isActive   Boolean  @default(true)
  language   Language @default(EN)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Login throttling - a 4-digit PIN is only 10k combinations.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Relations
  location        Location         @relation(fields: [locationId], references: [id], onDelete: Cascade)
  liveAdjustments LiveAdjustment[]
  resolvedAlerts  Alert[]          @relation("AlertResolvedBy")
  auditLogs       AuditLog[]
  counts          InventoryCount[]

  @@index([locationId])
  @@index([email])
  @@index([role])
}

model Location {
  id                 String   @id @default(cuid())
  name               String
  toastLocationId    String?  @unique
  toastClientId      String?
  toastClientSecret  String?
  writeBackEnabled   Boolean  @default(false)
  alertWindowMinutes Int      @default(60)
  createdAt          DateTime @default(now())

  // Service day runs from dayStartHour local time, not midnight UTC - a close
  // after midnight still belongs to the previous business day.
  timezone     String @default("America/Chicago")
  dayStartHour Int    @default(4)

  // Relations
  users          User[]
  inventoryItems InventoryItem[]
  menuItems      MenuItem[]
  saleEvents     SaleEvent[]
  auditLogs      AuditLog[]

  @@index([name])
  @@index([toastLocationId])
}

model InventoryItem {
  id          String   @id @default(cuid())
  locationId  String
  name        String
  unit        String
  parLevel    Float
  safetyStock Float
  toastItemId String?
  category    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  location          Location           @relation(fields: [locationId], references: [id], onDelete: Cascade)
  recipes           Recipe[]
  liveAdjustments   LiveAdjustment[]
  alerts            Alert[]
  forecastSnapshots ForecastSnapshot[]
  counts            InventoryCount[]

  @@unique([locationId, name])
  @@unique([locationId, toastItemId])
  @@index([locationId])
  @@index([category])
  @@index([isActive])
  @@index([toastItemId])
}

model MenuItem {
  id              String  @id @default(cuid())
  locationId      String
  toastMenuItemId String
  name            String
  isActive        Boolean @default(true)

  // Relations
  location   Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  recipes    Recipe[]
  saleEvents SaleEvent[]

  @@unique([locationId, toastMenuItemId])
  @@index([locationId])
  @@index([isActive])
  @@index([toastMenuItemId])
}

model Recipe {
  id              String @id @default(cuid())
  menuItemId      String
  inventoryItemId String
  quantityUsed    Float
  unit            String

  // Relations
  menuItem      MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, inventoryItemId])
  @@index([menuItemId])
  @@index([inventoryItemId])
}

model LiveAdjustment {
  id              String         @id @default(cuid())
  inventoryItemId String
  userId          String
  type            AdjustmentType
  quantity        Float
  unit            String
  reason          String?
  note            String?
  createdAt       DateTime       @default(now())

  // Relations
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model SaleEvent {
  id           String   @id @default(cuid())
  locationId   String
  toastOrderId String
  menuItemId   String
  quantity     Int
  createdAt    DateTime @default(now())

  // Relations
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([toastOrderId, menuItemId])
  @@index([locationId])
  @@index([menuItemId])
  @@index([toastOrderId])
  @@index([createdAt])
}

model Alert {
  id                   String      @id @default(cuid())
  inventoryItemId      String
  status               AlertStatus @default(ACTIVE)
  predictedDepletionAt DateTime
  resolvedAt           DateTime?
  resolvedByUserId     String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  // Relations
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  resolvedBy    User?         @relation("AlertResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([inventoryItemId])
  @@index([status])
  @@index([createdAt])
  @@index([resolvedByUserId])
  @@index([status, createdAt])
  @@index([inventoryItemId, status])
}

model ForecastSnapshot {
  id              String   @id @default(cuid())
  inventoryItemId String
  dayOfWeek       Int // 0-6 (Sunday-Saturday)
  avgSalesRate    Float // Average units sold per hour
  seasonality     Float    @default(1.0) // Multiplier for seasonal adjustment
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([inventoryItemId, dayOfWeek])
  @@index([inventoryItemId])
  @@index([dayOfWeek])
}

model AuditLog {
  id         String   @id @default(cuid())
  locationId String
  userId     String
  action     String
  entityType String
  entityId   String
  details    Json
  createdAt  DateTime @default(now())

  // Relations
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([locationId])
  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}

/// A physical count: someone looked in the cooler and wrote down what was there.
///
/// This is the anchor the stock figure counts forward from. Before counts
/// existed, stock ran from par level plus every adjustment since the start of
/// the service day, which drifted further from reality the longer it ran.
/// A count replaces that guess with an observation, and the time it was taken
/// is what makes the projection afterwards honest about its own age.
model InventoryCount {
  id              String      @id @default(cuid())
  inventoryItemId String
  userId          String
  quantity        Float
  unit            String
  storageArea     StorageArea @default(COOLER)
  countType       CountType
  note            String?
  countedAt       DateTime    @default(now())
  createdAt       DateTime    @default(now())

  // Relations
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The hot path is "latest count for this item", so order matters here.
  @@index([inventoryItemId, countedAt])
  @@index([userId])
  @@index([countedAt])
  @@index([countType])
}
